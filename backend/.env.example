# Copia este archivo como .env (en esta misma carpeta, backend/) y completa los valores.
# El archivo .env no se sube al repositorio. Aqui no van valores reales.
#
# Obligatorias: sin ellas el backend no arranca y avisa cual falta.
# JWT_SECRET: clave de firma de los tokens, en Base64 o hexadecimal de al menos 64 caracteres.
#   Se puede generar con: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
# CORREO_DARCA: buzon de DARCA que recibe las respuestas finales.
CORREO_DARCA=
#
# Opcionales: cuenta de Gmail que envia los correos y su contrasena de aplicacion
# (16 caracteres sin espacios). Sin ellas el backend arranca y el envio solo deja el error en el log.
MAIL_USER=
MAIL_PASSWORD=
