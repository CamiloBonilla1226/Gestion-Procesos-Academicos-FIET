# Copia este archivo como .env (en esta misma carpeta, backend/) y completa los valores.
# El archivo .env no se sube al repositorio. Aqui no van valores reales.
#
# Obligatorias: sin ellas el backend no arranca y avisa cual falta.
# JWT_SECRET: clave de firma de los tokens, en Base64 o hexadecimal de al menos 64 caracteres.
#   Se puede generar con: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
# CORREO_DARCA: buzon de DARCA que recibe las respuestas finales.
CORREO_DARCA=
#
# Opcionales: cuenta de Gmail que envia los correos y su contrasena de aplicacion
# (16 caracteres sin espacios). Sin ellas el backend arranca y el envio solo deja el error en el log.
MAIL_USER=
MAIL_PASSWORD=
#
# Opcional: nombre con que el backend se presenta al servidor de correo (EHLO). Por defecto fiet-unicauca.local.
# MAIL_EHLO=
#
# Opcional: si la red del equipo bloquea el correo por IPv4 y solo sale por IPv6, descomenta esta linea
# para que Java prefiera IPv6 (la red de docker-compose ya tiene IPv6). En redes sin IPv6 dejala comentada.
# JAVA_TOOL_OPTIONS=-Djava.net.preferIPv6Addresses=true
#
# Opcional: SHOW_SQL=true imprime cada consulta SQL en la salida del contenedor (solo para depurar).
# Por defecto false: con mucho trafico esa salida frena el backend si la consola que la recibe se detiene.
# SHOW_SQL=false
#
# Opcional: memoria del contenedor del backend y porcentaje de esa memoria que Java usa como heap.
# Por defecto 1g y 50 (heap de unos 512 MB). Si se sube el porcentaje, dejar al menos 300 MB fuera del heap.
# BACKEND_MEM_LIMIT=1g
# JAVA_MAX_RAM_PERCENTAGE=50
